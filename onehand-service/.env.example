# Settings for the measurement service (read by worker.py; no restart needed).
#
# Temporary test photos: after each measurement, save a card-blurred photo and an annotated
# photo (card outline + finger lines) in onehand-service/data/test-photos/.
# They show a hand: only turn this on while testing, and delete the folder afterwards.
#   true  = save     false = do not save (default)
RING_SAVE_TEST_PHOTOS=false
