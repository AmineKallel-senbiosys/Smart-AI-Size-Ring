# Copy to .env (and optionally .env.local), then fill in values.
# Never commit real secrets.

# Velio chat backend (optional)
OPEN_AI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.2
VELIO_HOST=127.0.0.1
VELIO_PORT=8001

# Next.js app
# Port used by `npm run dev` is 3456
CONFIG_PIN=000011
ONEHAND_SERVICE_URL=http://127.0.0.1:4185

# Public https URL when testing camera from a phone (ngrok / tunnel)
NEXT_PUBLIC_PUBLIC_URL=
NEXT_PUBLIC_SIZER_URL=

# Measurement service (onehand-service): save temporary test photos?
# After each measurement it saves a card-blurred photo and an annotated one (card outline + finger lines)
# in onehand-service/data/test-photos/. They show a hand: only use this while testing.
#   true = save    false = do not save (default)
# Read on every photo, so no restart is needed after changing it.
RING_SAVE_TEST_PHOTOS=false
